# Generation by Fuel

```julia; echo = false
using PowerGraphics
using PowerAnalytics

results = WEAVE_ARGS["results"]
backend = WEAVE_ARGS["backend"]

plot_fuel(results; backend = backend)
```

# Reserves

```julia; echo = false
# One stacked trace per reserve product, keyed by the service name.
reserves = Dict(
    String(last(split(String(key), "__"))) => df for
    (key, df) in PowerAnalytics.get_service_data(results).data
)
if isempty(reserves)
    println("No reserve results in this simulation.")
else
    plot_results(reserves; backend = backend, stack = true, title = "Reserves", y_label = "MW")
end
```
